{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./static",
    "rootDir": "./static",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": ["static/**/*"],
  "exclude": ["node_modules", "downloads", "__pycache__"]
}
